PORT=5000
NODE_ENV=development
DATA_FILE_PATH=../data/portfolio.json
CORS_ORIGIN=*

# 관리자 인증 (단방향 해시 및 솔트)
ADMIN_PASSWORD_HASH=your_password_sha256_hash_here
ADMIN_SALT=your_random_salt_string
ADMIN_TOKEN_SECRET=your_jwt_secret_key_here

# Supabase (DB 연결)
SUPABASE_URL=https://your-project-ref.supabase.co
# 공개용 키(sb_publishable_...): 브라우저에 있어도 안전하며 보안은 RLS가 담당
SUPABASE_ANON_KEY=your_publishable_key_here
# 비밀 키(sb_secret_...): 서버(.env)에서만 사용, 절대 GitHub·프론트엔드에 올리지 않음
SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here

# 데이터 저장 방식: supabase(기본, DB) | file(data/portfolio.json, 오프라인·시험용)
DB_TYPE=supabase
