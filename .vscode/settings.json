{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "search.exclude": {
    "**/*.ai": true,
    "**/panel_large.jpg": true
  },
  "files.exclude": {
    "**/__pycache__": true
  },
  "files.associations": {
    "*.md": "markdown"
  }
}
